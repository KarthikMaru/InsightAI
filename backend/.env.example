# Server
PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=insightai
DB_USER=root
DB_PASSWORD=password

# JWT
JWT_SECRET=jwt key here
JWT_EXPIRES_IN=7d

# Google Gemini
GEMINI_API_KEY=Gemiini-API-Key-Here
# gemini-1.5-flash has been deprecated/shut down by Google — use a current
# model (gemini-2.5-flash is this app's default if this var is omitted).
GEMINI_MODEL=gemini-3.5-flash-lite

# CORS
CLIENT_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
